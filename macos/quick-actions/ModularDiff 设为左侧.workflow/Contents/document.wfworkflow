<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>AMAccepts</key>
	<dict>
		<key>Container</key>
		<string>Substitutes</string>
		<key>Types</key>
		<array>
			<string>com.apple.cocoa.path</string>
		</array>
	</dict>
	<key>AMApplication</key>
	<array>
		<string>com.apple.finder</string>
	</array>
	<key>AMCanShowWhenRun</key>
	<false/>
	<key>AMCategory</key>
	<string>AMCategoryUtilities</string>
	<key>AMComment</key>
	<string>记住此文件夹作为比较左侧</string>
	<key>AMKeywords</key>
	<array>
		<string>compare</string>
		<string>diff</string>
		<string>ModularDiff</string>
		<string>比较</string>
	</array>
	<key>AMName</key>
	<string>ModularDiff 设为左侧</string>
	<key>AMProvides</key>
	<dict>
		<key>Container</key>
		<string>List</string>
		<key>Types</key>
		<array/>
	</dict>
	<key>WFWorkflowActions</key>
	<array>
		<dict>
			<key>WFWorkflowActionIdentifier</key>
			<string>com.apple.RunShellScript</string>
			<key>WFWorkflowActionParameters</key>
			<dict>
				<key>command</key>
				<string>STATE_DIR="$HOME/Library/Application Support/ModularDiff"
mkdir -p "$STATE_DIR"
if [ $# -ne 1 ]; then
  osascript -e 'display notification "请只选择一个文件/文件夹" with title "ModularDiff"'
  exit 0
fi
printf '%s' "$1" &gt; "$STATE_DIR/pending-left"
NAME=$(basename "$1" | sed 's/["\\]//g')
osascript -e "display notification \"左侧已设为: $NAME\n请右键另一侧文件夹,选『用 ModularDiff 比较』\" with title \"ModularDiff\""
</string>
				<key>input</key>
				<string>Argument</string>
				<key>shell</key>
				<string>/bin/zsh</string>
			</dict>
		</dict>
	</array>
	<key>WFWorkflowBuildVersion</key>
	<string>523.2</string>
	<key>WFWorkflowClientReleaseVersion</key>
	<string>15.0</string>
	<key>WFWorkflowClientVersion</key>
	<string>Automator 1.5</string>
	<key>WFWorkflowHasShortcutInputVariables</key>
	<false/>
	<key>WFWorkflowInputContentItemClasses</key>
	<array>
		<string>com.apple.cocoa.path</string>
	</array>
	<key>WFWorkflowTypes</key>
	<array>
		<string>Quick Action</string>
	</array>
</dict>
</plist>
