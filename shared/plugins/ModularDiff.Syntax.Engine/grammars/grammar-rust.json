{
  "language": "Rust",
  "extensions": [".rs"],
  "rules": [
    { "pattern": "(//.*$|/\*[\s\S]*?\*/)", "kind": "Comment", "priority": 0 },
    { "pattern": "(\"(?:[^\"\\]|\\.)*\")", "kind": "String", "priority": 1 },
    { "pattern": "\b(as|async|await|break|const|continue|crate|dyn|else|enum|extern|false|fn|for|if|impl|in|let|loop|match|mod|move|mut|pub|ref|return|self|Self|static|struct|super|trait|true|type|unsafe|use|where|while)\b", "kind": "Keyword", "priority": 2 },
    { "pattern": "\b(0x[0-9a-fA-F_]+|\d[\d_]*\.?\d*)\b", "kind": "Number", "priority": 3 },
    { "pattern": "('[a-z_]\w*)", "kind": "Type", "priority": 4 }
  ]
}
