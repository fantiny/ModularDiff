<Window x:Class="ModularDiff.Gui.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:ModularDiff.Gui.Controls" Title="ModularDiff — 左右分栏比较" Width="1440" Height="900" MinWidth="1040" MinHeight="640" Background="#F1F3F7" Foreground="#354255" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="12" WindowStartupLocation="CenterScreen" PreviewKeyDown="WindowKeyDown" AllowDrop="True" Drop="WindowDrop">
 <Grid x:Name="RootLayout" Background="#F1F3F7">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="10,3"><TextBlock Text="MODULAR DIFF" FontSize="11" FontWeight="Bold" Foreground="#2E5693"/><TextBlock x:Name="PluginSummary" HorizontalAlignment="Right" Foreground="#8290A3"/></DockPanel>
  <Border Grid.Row="1" Background="#E8ECF2" BorderBrush="#D6DDE7" BorderThickness="0,1"><DockPanel><TextBlock DockPanel.Dock="Right" x:Name="EditStatusLabel" Text="只读" Margin="16,0" VerticalAlignment="Center" Foreground="#8290A3"/><StackPanel Orientation="Horizontal"><ToggleButton x:Name="FolderTab" Style="{StaticResource SessionTab}" Content="▰ 目录比较" IsChecked="True" Click="FolderTabClick"/><ToggleButton x:Name="TextTab" Style="{StaticResource SessionTab}" Content="≡ 文本比较" IsEnabled="False" Click="TextTabClick"/></StackPanel></DockPanel></Border>
  <Border Grid.Row="2" Padding="8,4" Background="White" BorderBrush="#DDE3EC" BorderThickness="0,0,0,1"><WrapPanel><Button x:Name="CompareButton" Background="#3569AE" Foreground="White" BorderBrush="#3569AE" Click="CompareClick" Style="{StaticResource IconButton}" FontFamily="Segoe MDL2 Assets" Content="&#xE768;" ToolTip="开始 / 重新比较（F5）"/><Button x:Name="CancelButton" IsEnabled="False" Click="CancelClick" Style="{StaticResource IconButton}" FontFamily="Segoe MDL2 Assets" Content="&#xE71A;" ToolTip="停止比较（Esc）"/><Button Click="SwapClick" Style="{StaticResource IconButton}" FontFamily="Segoe MDL2 Assets" Content="&#xE8AB;" ToolTip="交换左右路径并重新比较"/><Button Click="NewWindowClick" Style="{StaticResource IconButton}" FontFamily="Segoe MDL2 Assets" Content="&#xE8F5;" ToolTip="新开一个比较窗口（Ctrl+N）；新窗口自动错开排列"/><Button Click="MergeWindowClick" Style="{StaticResource IconButton}" FontFamily="Segoe MDL2 Assets" Content="&#xE8E8;" ToolTip="三路合并：公共祖先 + 左右两侧 → 可编辑的合并结果（处理冲突）"/><Separator Width="12"/><Button x:Name="OpenButton" Click="OpenSelectedClick" Style="{StaticResource IconButton}" FontFamily="Segoe MDL2 Assets" Content="&#xE8E5;" ToolTip="打开所选文件（Enter）"/><Button x:Name="PreviousFileButton" Click="PreviousFile" Style="{StaticResource IconButton}" FontFamily="Segoe MDL2 Assets" Content="&#xE892;" ToolTip="上一文件（Alt+Up）"/><Button x:Name="NextFileButton" Click="NextFile" Style="{StaticResource IconButton}" FontFamily="Segoe MDL2 Assets" Content="&#xE893;" ToolTip="下一文件（Alt+Down）"/><Separator Width="12"/><Button Click="PreviousDiff" Style="{StaticResource IconButton}" FontFamily="Segoe MDL2 Assets" Content="&#xE74A;" ToolTip="上一差异块（Shift+F7）"/><Button Click="NextDiff" Style="{StaticResource IconButton}" FontFamily="Segoe MDL2 Assets" Content="&#xE74B;" ToolTip="下一差异块（F7）"/><Separator Width="12"/><Button x:Name="ExportButton" Click="ExportClick" IsEnabled="False" Style="{StaticResource IconButton}" FontFamily="Segoe MDL2 Assets" Content="&#xE9F9;" ToolTip="导出比较报告"/><Button x:Name="SaveAllButton" Click="SaveAll" Style="{StaticResource IconButton}" FontFamily="Segoe MDL2 Assets" Content="&#xE74E;" ToolTip="保存左右两侧（Ctrl+Shift+S）"/><Button x:Name="UndoButton" Click="UndoClick" Style="{StaticResource IconButton}" FontFamily="Segoe MDL2 Assets" Content="&#xE7A7;" ToolTip="撤销当前侧修改（Ctrl+Z）"/><Button x:Name="RedoButton" Click="RedoClick" Style="{StaticResource IconButton}" FontFamily="Segoe MDL2 Assets" Content="&#xE7A6;" ToolTip="重做当前侧修改（Ctrl+Y）"/><ToggleButton x:Name="SettingsToggle" Width="28" Height="28" Margin="3,0" FontFamily="Segoe MDL2 Assets" Content="&#xE713;" ToolTip="比较规则、插件和报告格式"/></WrapPanel></Border>
  <Grid Grid.Row="3" Margin="8,5,8,5"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><DockPanel Grid.Row="0"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button x:Name="SaveLeftButton" Click="SaveLeft" Style="{StaticResource LabeledIconButton}" ToolTip="保存左侧文件（Ctrl+S 保存当前侧）"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE74E;"/><TextBlock Text="保存左" Margin="5,0,0,0"/></StackPanel></Button><Button Tag="left" Click="BrowseFile" Style="{StaticResource IconButton}" FontFamily="Segoe MDL2 Assets" Content="&#xE8A5;" ToolTip="选择文件"/><Button Tag="left" Click="BrowseFolder" Style="{StaticResource IconButton}" FontFamily="Segoe MDL2 Assets" Content="&#xE8B7;" ToolTip="选择目录"/></StackPanel><TextBox x:Name="LeftPath" AutomationProperties.Name="左侧路径" ToolTip="文件或目录路径；支持拖入"/></DockPanel></Grid>
   <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><DockPanel Grid.Row="0"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button x:Name="SaveRightButton" Click="SaveRight" Style="{StaticResource LabeledIconButton}" ToolTip="保存右侧文件（Ctrl+S 保存当前侧）"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE74E;"/><TextBlock Text="保存右" Margin="5,0,0,0"/></StackPanel></Button><Button Tag="right" Click="BrowseFile" Style="{StaticResource IconButton}" FontFamily="Segoe MDL2 Assets" Content="&#xE8A5;" ToolTip="选择文件"/><Button Tag="right" Click="BrowseFolder" Style="{StaticResource IconButton}" FontFamily="Segoe MDL2 Assets" Content="&#xE8B7;" ToolTip="选择目录"/></StackPanel><TextBox x:Name="RightPath" AutomationProperties.Name="右侧路径" ToolTip="文件或目录路径；支持拖入"/></DockPanel></Grid>
  </Grid>
  <Popup Opened="ExplorerSettingsOpened" PlacementTarget="{Binding ElementName=SettingsToggle}" Placement="Bottom" IsOpen="{Binding IsChecked, ElementName=SettingsToggle, Mode=TwoWay}" StaysOpen="False" AllowsTransparency="True"><Border Background="White" BorderBrush="#CAD2DE" BorderThickness="1" Padding="12"><ScrollViewer MaxHeight="520" VerticalScrollBarVisibility="Auto"><StackPanel Width="300"><TextBlock Text="资源管理器右键菜单" FontWeight="SemiBold"/><TextBlock x:Name="ExplorerMenuStatus" TextWrapping="Wrap"/><TextBlock Text="比较会话" FontWeight="SemiBold" Margin="0,8,0,0"/><WrapPanel><ComboBox x:Name="SessionBox" Width="150" SelectionChanged="SessionSelected" ToolTip="已保存的命名会话：左右路径 + 算法 + 忽略选项"/><Button x:Name="SaveSessionButton" Content="保存当前" Click="SaveSessionClick" ToolTip="把当前左右路径与比较选项保存为命名会话"/><Button x:Name="DeleteSessionButton" Content="删除" Click="DeleteSessionClick" ToolTip="删除选中的命名会话"/></WrapPanel><WrapPanel Margin="0,4,0,0"><ComboBox x:Name="RecentBox" Width="220" SelectionChanged="RecentSelected" ToolTip="最近比较（自动记录，最多 10 条）"/></WrapPanel><TextBlock Text="模块" VerticalAlignment="Center"/><WrapPanel><Button x:Name="RegisterMenuButton" Content="注册右键菜单" Click="InstallExplorerClick" ToolTip="注册到当前用户，无需管理员权限；移动程序后可重新注册"/><Button x:Name="UnregisterMenuButton" Content="取消注册" Click="UninstallExplorerClick" ToolTip="移除 ModularDiff 菜单和记住的左侧路径"/></WrapPanel>
<TextBlock Text="Windows 11 菜单样式" FontWeight="SemiBold" Margin="0,8,0,0"/><TextBlock x:Name="ClassicMenuStatus" TextWrapping="Wrap"/><WrapPanel><Button x:Name="ClassicMenuButton" Content="经典全展开" Click="ClassicMenuClick" ToolTip="为当前用户设置整个资源管理器的经典菜单；重启资源管理器或注销后生效。部分 Windows 版本可能不支持此兼容设置"/><Button x:Name="ModernMenuButton" Content="恢复默认菜单" Click="ModernMenuClick" ToolTip="移除经典菜单兼容设置；重启资源管理器或注销后生效"/></WrapPanel><TextBlock Text="影响整个资源管理器；需重启资源管理器或注销。" TextWrapping="Wrap" Foreground="#667085"/><TextBlock x:Name="ExplorerSettingsFeedback" TextWrapping="Wrap" Foreground="#667085" Margin="0,4,0,8"/><TextBlock Text="模块" VerticalAlignment="Center"/><ComboBox x:Name="ModuleBox" DisplayMemberPath="DisplayName"/><TextBlock Text="算法" VerticalAlignment="Center"/><ComboBox x:Name="AlgorithmBox" DisplayMemberPath="DisplayName"/><TextBlock Text="展示" VerticalAlignment="Center"/><ComboBox x:Name="PresentationBox" DisplayMemberPath="DisplayName"/><CheckBox x:Name="IgnoreCaseBox" Content="忽略大小写"/><CheckBox x:Name="IgnoreWhitespaceBox" Content="忽略行内空白"/><CheckBox x:Name="IgnoreEolBox" Content="忽略换行"/><TextBox x:Name="UnimportantBox" Height="52" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" ToolTip="不重要差异规则：每行一个正则，匹配文本不参与差异判断（如 \$Id[^$]*\$、时间戳、版本号）。无效规则会被忽略并提示。" AutomationProperties.Name="不重要差异规则"/><CheckBox x:Name="RecursiveBox" Content="递归子目录" IsChecked="True"/><TextBlock Text="报告格式"/><ComboBox x:Name="FormatBox" DisplayMemberPath="DisplayName"/><TextBlock Text="编辑缓冲"/><ComboBox x:Name="BufferBox" DisplayMemberPath="DisplayName"/><TextBlock Text="文本存储"/><ComboBox x:Name="StorageBox" DisplayMemberPath="DisplayName"/><TextBlock Text="缓冲比较"/><ComboBox x:Name="BufferCompareBox" DisplayMemberPath="DisplayName"/><TextBlock Text="差异块合并"/><ComboBox x:Name="MergeBox" DisplayMemberPath="DisplayName"/><TextBlock Text="同步计划"/><ComboBox x:Name="SyncPlannerBox" DisplayMemberPath="DisplayName"/><TextBlock Text="同步预览"/><ComboBox x:Name="SyncPreviewBox" DisplayMemberPath="DisplayName"/><TextBlock Text="同步执行"/><ComboBox x:Name="SyncExecutorBox" DisplayMemberPath="DisplayName"/><TextBlock Text="同步备份"/><ComboBox x:Name="SyncBackupBox" DisplayMemberPath="DisplayName"/><TextBlock Text="操作记录"/><ComboBox x:Name="SyncJournalBox" DisplayMemberPath="DisplayName"/><TextBlock Text="撤销恢复"/><ComboBox x:Name="SyncRecoveryBox" DisplayMemberPath="DisplayName"/></StackPanel></ScrollViewer></Border></Popup>
  <Grid Grid.Row="5" Margin="8,0,8,0">
   <Grid x:Name="FolderView"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,8"><TextBlock x:Name="FolderSummary" DockPanel.Dock="Right" VerticalAlignment="Center" Foreground="#8390A1"/><StackPanel Orientation="Horizontal"><Button Click="SyncHistoryClick" Style="{StaticResource IconButton}" FontFamily="Segoe MDL2 Assets" Content="&#xE81C;" ToolTip="同步历史 / 撤销恢复：查看自动备份、操作结果并预览恢复"/><Button Tag="selected-left" Click="FolderSyncClick" Style="{StaticResource IconButton}" FontFamily="Segoe MDL2 Assets" Content="&#xE72B;" ToolTip="预览所选文件 / 目录：右 → 左复制（Ctrl/Shift 多选）"/><Button Tag="selected-right" Click="FolderSyncClick" Style="{StaticResource IconButton}" FontFamily="Segoe MDL2 Assets" Content="&#xE72A;" ToolTip="预览所选文件 / 目录：左 → 右复制（Ctrl/Shift 多选）"/><Button Tag="batch-left" Click="FolderSyncClick" Style="{StaticResource IconButton}" FontFamily="Segoe MDL2 Assets" Content="&#xE892;" ToolTip="预览当前筛选的全部文件：右 → 左批量同步"/><Button Tag="batch-right" Click="FolderSyncClick" Style="{StaticResource IconButton}" FontFamily="Segoe MDL2 Assets" Content="&#xE893;" ToolTip="预览当前筛选的全部文件：左 → 右批量同步"/><Button Tag="batch-both" Click="FolderSyncClick" Style="{StaticResource IconButton}" FontFamily="Segoe MDL2 Assets" Content="&#xE895;" ToolTip="预览当前筛选的全部文件：双向补齐；同名内容冲突手动选方向"/><TextBlock Text="显示" VerticalAlignment="Center"/><ComboBox x:Name="FolderFilter" SelectionChanged="FolderFilterChanged" SelectedIndex="0"><ComboBoxItem Content="全部文件"/><ComboBoxItem Content="有差异"/><ComboBoxItem Content="相同"/><ComboBoxItem Content="仅左侧"/><ComboBoxItem Content="仅右侧"/></ComboBox><TextBox x:Name="FolderSearch" Width="140" TextChanged="FolderSearchChanged" ToolTip="按相对路径筛选文件" AutomationProperties.Name="筛选文件"/><Button Click="ClearFolderSearch" Style="{StaticResource IconButton}" FontFamily="Segoe MDL2 Assets" Content="&#xE711;" ToolTip="清除目录筛选"/><Button Click="ExpandAll" Style="{StaticResource IconButton}" FontFamily="Segoe MDL2 Assets" Content="&#xE8A3;" ToolTip="展开所有目录"/><Button Click="CollapseAll" Style="{StaticResource IconButton}" FontFamily="Segoe MDL2 Assets" Content="&#xE8A4;" ToolTip="折叠所有目录"/></StackPanel></DockPanel>
    <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="300"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*" MinWidth="300"/></Grid.ColumnDefinitions>
     <DataGrid x:Name="LeftFolders" SelectionMode="Extended" RowStyle="{StaticResource FolderRow}" SelectionChanged="FolderSelectionChanged" MouseDoubleClick="FolderDoubleClick" PreviewKeyDown="FolderKeyDown" ScrollViewer.ScrollChanged="FolderScrolled" AutomationProperties.Name="左侧目录树">
      <DataGrid.Columns><DataGridTemplateColumn Header="名称" Width="*" MinWidth="160"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel x:Name="LeftNameCell" Orientation="Horizontal" Margin="{Binding Indent}"><TextBlock Text="{Binding Symbol}" Width="17" MouseLeftButtonDown="FolderExpanderClick" Cursor="Hand"/><TextBlock Text="{Binding KindIcon}" Width="19" Foreground="{Binding Color}"/><TextBlock Text="{Binding LeftName}" TextTrimming="CharacterEllipsis"/></StackPanel><DataTemplate.Triggers><DataTrigger Binding="{Binding LeftExists}" Value="False"><Setter TargetName="LeftNameCell" Property="Visibility" Value="Hidden"/></DataTrigger></DataTemplate.Triggers></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="大小" Binding="{Binding LeftSize}" Width="72"/><DataGridTextColumn Header="修改时间" Binding="{Binding LeftModified}" Width="130"/><DataGridTextColumn Header="状态" Binding="{Binding StatusGlyph}" Width="42"/></DataGrid.Columns>
     </DataGrid>
     <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" Background="#DCE2EB"/>
     <DataGrid x:Name="RightFolders" SelectionMode="Extended" Grid.Column="2" RowStyle="{StaticResource FolderRow}" SelectionChanged="FolderSelectionChanged" MouseDoubleClick="FolderDoubleClick" PreviewKeyDown="FolderKeyDown" ScrollViewer.ScrollChanged="FolderScrolled" AutomationProperties.Name="右侧目录树">
      <DataGrid.Columns><DataGridTextColumn Header="状态" Binding="{Binding StatusGlyph}" Width="42"/><DataGridTemplateColumn Header="名称" Width="*" MinWidth="160"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel x:Name="RightNameCell" Orientation="Horizontal" Margin="{Binding Indent}"><TextBlock Text="{Binding Symbol}" Width="17" MouseLeftButtonDown="FolderExpanderClick" Cursor="Hand"/><TextBlock Text="{Binding KindIcon}" Width="19" Foreground="{Binding Color}"/><TextBlock Text="{Binding RightName}" TextTrimming="CharacterEllipsis"/></StackPanel><DataTemplate.Triggers><DataTrigger Binding="{Binding RightExists}" Value="False"><Setter TargetName="RightNameCell" Property="Visibility" Value="Hidden"/></DataTrigger></DataTemplate.Triggers></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="大小" Binding="{Binding RightSize}" Width="72"/><DataGridTextColumn Header="修改时间" Binding="{Binding RightModified}" Width="130"/></DataGrid.Columns>
     </DataGrid>
    </Grid>
    
   </Grid>
   <Grid x:Name="TextView" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <WrapPanel Margin="0,0,0,4"><Button x:Name="MergeLeftButton" Click="CopyRightToLeft" Style="{StaticResource IconButton}" FontFamily="Segoe MDL2 Assets" Content="&#xE72B;" ToolTip="将当前差异块从右复制到左（Ctrl+Alt+Left）"/><Button x:Name="CopyAllLeftButton" Click="CopyAllLeft" Style="{StaticResource LabeledIconButton}" ToolTip="全部差异块从右复制到左"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE72B;"/><TextBlock Text="⇇" Margin="2,0,0,0" FontWeight="Bold"/></StackPanel></Button><Button x:Name="MergeRightButton" Click="CopyLeftToRight" Style="{StaticResource IconButton}" FontFamily="Segoe MDL2 Assets" Content="&#xE72A;" ToolTip="将当前差异块从左复制到右（Ctrl+Alt+Right）"/><Button x:Name="CopyAllRightButton" Click="CopyAllRight" Style="{StaticResource LabeledIconButton}" ToolTip="全部差异块从左复制到右"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE72A;"/><TextBlock Text="⇉" Margin="2,0,0,0" FontWeight="Bold"/></StackPanel></Button><Button x:Name="FormatButton" Click="FormatSideClick" Style="{StaticResource LabeledIconButton}" ToolTip="按语言格式化当前聚焦侧（需格式化插件，如 css-format）"><StackPanel Orientation="Horizontal"><TextBlock Text="⌗"/><TextBlock Text="格式化" Margin="5,0,0,0"/></StackPanel></Button><Button x:Name="RealignButton" Click="RealignClick" Style="{StaticResource LabeledIconButton}" ToolTip="立即重新对齐：按当前算法与忽略选项重算，不重读磁盘，保留未保存修改"><StackPanel Orientation="Horizontal"><TextBlock Text="⟳"/><TextBlock Text="对齐" Margin="5,0,0,0"/></StackPanel></Button><ToggleButton x:Name="AutoRealignToggle" Height="28" Margin="1,0" Padding="8,3" FontSize="12" ToolTip="自动重对齐：编辑、换行、格式化后立即重算对齐；关闭后点“对齐”手动重算" IsChecked="True" Checked="AutoRealignChanged" Unchecked="AutoRealignChanged"><StackPanel Orientation="Horizontal"><TextBlock Text="⚡"/><TextBlock Text="自动" Margin="5,0,0,0"/></StackPanel></ToggleButton><TextBlock Text="显示" VerticalAlignment="Center"/><ComboBox x:Name="TextFilter" SelectionChanged="TextFilterChanged" SelectedIndex="0"><ComboBoxItem Content="全部行"/><ComboBoxItem Content="仅差异"/><ComboBoxItem Content="差异 + 3 行上下文"/></ComboBox><ToggleButton x:Name="LockHorizontal" Content="&#xE71B;" FontFamily="Segoe MDL2 Assets" Width="28" Height="28" Margin="1,0" ToolTip="联动水平滚动" IsChecked="True"/><ToggleButton x:Name="ShowEol" Content="¶" Width="28" Height="28" Margin="1,0" ToolTip="显示换行符" IsChecked="False" Click="ShowEolClick"/><ToggleButton x:Name="WrapToggle" Height="28" Margin="1,0" Padding="8,3" FontSize="12" ToolTip="长行折行显示（Alt+Z）；两侧同行取最大高度保持对齐" IsChecked="False" Checked="WrapChanged" Unchecked="WrapChanged"><StackPanel Orientation="Horizontal"><TextBlock Text="↩"/><TextBlock Text="折行" Margin="5,0,0,0"/></StackPanel></ToggleButton><Button Click="ToggleLayoutClick" Style="{StaticResource LabeledIconButton}" ToolTip="切换左右 / 上下布局"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8E5;"/><TextBlock Text="布局" Margin="5,0,0,0"/></StackPanel></Button><TextBox x:Name="FindBox" Width="170" ToolTip="搜索代码（Ctrl+F）；Enter 查找下一处" PreviewKeyDown="FindKeyDown" AutomationProperties.Name="查找代码"/><Button Click="FindNextClick" Style="{StaticResource IconButton}" FontFamily="Segoe MDL2 Assets" Content="&#xE721;" ToolTip="查找下一处（F3）"/><ToggleButton x:Name="ReplaceToggle" Content="⇆" Width="28" Height="28" Margin="1,0" ToolTip="查找替换（Ctrl+H）" Checked="ReplaceToggleChanged" Unchecked="ReplaceToggleChanged"/><TextBox x:Name="ReplaceBox" Width="130" Visibility="Collapsed" ToolTip="替换文本；Enter 替换下一处（作用于聚焦侧）" PreviewKeyDown="ReplaceKeyDown" AutomationProperties.Name="替换文本"/><Button x:Name="ReplaceOneButton" Content="替换" Visibility="Collapsed" Click="ReplaceOneClick" Style="{StaticResource IconButton}" ToolTip="替换当前聚焦侧的下一处匹配"/><Button x:Name="ReplaceAllButton" Content="全部" Visibility="Collapsed" Click="ReplaceAllClick" Style="{StaticResource IconButton}" ToolTip="替换聚焦侧全部匹配（单次编辑，可整体撤销）"/><Button Click="ZoomOut" Style="{StaticResource IconButton}" FontFamily="Segoe MDL2 Assets" Content="&#xE8A4;" ToolTip="缩小代码文字"/><Button Click="ZoomIn" Style="{StaticResource IconButton}" FontFamily="Segoe MDL2 Assets" Content="&#xE8A3;" ToolTip="放大代码文字"/></WrapPanel>
    <Grid Grid.Row="1" Background="#E6EBF2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/></Grid.ColumnDefinitions><StackPanel Margin="8,4"><TextBlock x:Name="LeftFileTitle" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="LeftFileInfo" Visibility="Collapsed" Foreground="#8290A1" FontSize="11" Margin="0,3,0,0"/></StackPanel><StackPanel Grid.Column="2" Margin="8,4"><TextBlock x:Name="RightFileTitle" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="RightFileInfo" Visibility="Collapsed" Foreground="#8290A1" FontSize="11" Margin="0,3,0,0"/></StackPanel></Grid>
    <Grid Grid.Row="2" x:Name="TextGrid"><Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="280"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*" MinWidth="280"/><ColumnDefinition Width="24"/></Grid.ColumnDefinitions>
     <ScrollViewer x:Name="LeftCodeScroll" CanContentScroll="True" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Visible"><ui:DiffPane x:Name="LeftCode" IsLeft="True"/></ScrollViewer><GridSplitter x:Name="TextSplitter" Grid.Column="1" Width="6" HorizontalAlignment="Center" Background="#DCE2EB"/><ScrollViewer x:Name="RightCodeScroll" Grid.Column="2" CanContentScroll="True" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Visible"><ui:DiffPane x:Name="RightCode"/></ScrollViewer><ui:DiffOverview x:Name="Overview" Grid.Column="3" Margin="4,0,0,17"/>
     <Border x:Name="TextEmptyState" Grid.ColumnSpan="3" Background="#F7F9FC" Visibility="Collapsed"><TextBlock x:Name="TextEmptyMessage" Text="没有可显示的文本差异" VerticalAlignment="Center" HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="650" Foreground="#8290A1"/></Border>
     <Border x:Name="HexHost" Grid.ColumnSpan="4" Background="White" Visibility="Collapsed" ToolTip="十六进制视图：红色为差异字节；左右两侧共享偏移列"><ScrollViewer CanContentScroll="True" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Visible"><ui:HexView x:Name="Hex"/></ScrollViewer></Border>
     <Border x:Name="PictureHost" Grid.ColumnSpan="4" Background="White" Visibility="Collapsed" ToolTip="图片比较：右侧红色半透明为差异像素（尺寸一致时叠加显示）"><ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"><StackPanel Orientation="Horizontal"><Image x:Name="LeftPicture" Stretch="None" Margin="10,8"/><Rectangle Width="1" Fill="#DEE3EA"/><Image x:Name="RightPicture" Stretch="None" Margin="10,8"/></StackPanel></ScrollViewer></Border>
    </Grid>
    <TextBlock Grid.Row="3" x:Name="DetailLabel" Visibility="Collapsed" Margin="0,8" Foreground="#77859A" TextTrimming="CharacterEllipsis" Text="F7 / Shift+F7 跳转差异块 · Ctrl+F 查找 · 拖动选择行，Ctrl+C 复制"/>
   </Grid>
  </Grid>
  <Border Grid.Row="6" Background="#E7ECF3" Padding="10,4" BorderBrush="#D5DDE8" BorderThickness="0,1,0,0"><DockPanel><TextBlock x:Name="ActivityLabel" DockPanel.Dock="Right" Text="就绪" Foreground="#738399" Margin="12,0,0,0"/><TextBlock x:Name="FileStatsLabel" DockPanel.Dock="Left" Text="" Foreground="#5A6B80" Margin="0,0,14,0"/><TextBlock x:Name="HunkLabel" Text="" Foreground="#A35D39" Margin="0,0,14,0"/><TextBlock x:Name="StatusLabel" Text="选择两个文件或目录，开始左右比较。支持拖入路径。" TextTrimming="CharacterEllipsis" Foreground="#5A6B80"/></DockPanel></Border>
 </Grid>
</Window>