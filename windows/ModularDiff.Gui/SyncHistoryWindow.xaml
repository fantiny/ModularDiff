<Window x:Class="ModularDiff.Gui.SyncHistoryWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="同步历史与恢复" Width="1120" Height="680" MinWidth="850" MinHeight="440" WindowStartupLocation="CenterOwner" Background="#F1F3F7" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="12">
 <Grid x:Name="HistoryRoot" Margin="8" Background="#F1F3F7"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="180"/><RowDefinition Height="6"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,6"><StackPanel DockPanel.Dock="Left" Orientation="Horizontal"><Button x:Name="RestoreButton" Click="RestoreClick" Style="{StaticResource IconButton}" Content="&#xE7A7;" FontFamily="Segoe MDL2 Assets" ToolTip="恢复下方勾选项；覆盖项恢复原版本，新增项移除并留存副本；冲突项跳过" IsEnabled="False"/><Button x:Name="RefreshButton" Click="RefreshClick" Style="{StaticResource IconButton}" Content="&#xE72C;" FontFamily="Segoe MDL2 Assets" ToolTip="重新读取持久化操作记录和文件状态"/><Button x:Name="StopButton" Click="StopClick" Style="{StaticResource IconButton}" Content="&#xE71A;" FontFamily="Segoe MDL2 Assets" ToolTip="停止后续恢复，已完成的恢复保留" IsEnabled="False"/><Button Click="CloseClick" Style="{StaticResource IconButton}" Content="&#xE711;" FontFamily="Segoe MDL2 Assets" ToolTip="关闭历史窗口"/></StackPanel><TextBlock x:Name="Summary" Margin="10,0" VerticalAlignment="Center"/></DockPanel>
  <TextBlock x:Name="StoreLabel" Grid.Row="1" Foreground="#64748B" TextTrimming="CharacterEllipsis" Margin="2,0,2,6"/>
  <DataGrid x:Name="OperationsGrid" Grid.Row="2" SelectionChanged="OperationSelected"><DataGrid.Columns><DataGridTextColumn Header="时间" Binding="{Binding Time}" Width="155"/><DataGridTextColumn Header="状态" Binding="{Binding State}" Width="110"/><DataGridTextColumn Header="文件" Binding="{Binding Count}" Width="50"/><DataGridTextColumn Header="左侧目录" Binding="{Binding Operation.LeftRoot}" Width="*"/><DataGridTextColumn Header="右侧目录" Binding="{Binding Operation.RightRoot}" Width="*"/></DataGrid.Columns></DataGrid>
  <GridSplitter Grid.Row="3" Height="4" HorizontalAlignment="Stretch" Background="#DCE2EB"/>
  <DataGrid x:Name="EntriesGrid" Grid.Row="4" IsReadOnly="False" RowHeight="28"><DataGrid.Columns><DataGridTemplateColumn Header="恢复" Width="45"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding Selected, Mode=TwoWay}" IsEnabled="{Binding CanRestore}" Margin="10,0" ToolTip="勾选本次要恢复的文件"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="相对路径" Binding="{Binding Item.RelativePath}" Width="*" IsReadOnly="True"/><DataGridTextColumn Header="恢复动作" Binding="{Binding Item.Action}" Width="240" IsReadOnly="True"/><DataGridTextColumn Header="状态 / 冲突原因" Binding="{Binding Item.Reason}" Width="2*" IsReadOnly="True"/></DataGrid.Columns><DataGrid.RowStyle><Style TargetType="DataGridRow"><Setter Property="ToolTip" Value="{Binding Item.Target}"/></Style></DataGrid.RowStyle></DataGrid>
  <TextBlock x:Name="Status" Grid.Row="5" TextTrimming="CharacterEllipsis" Margin="2,6,2,0" Foreground="#64748B"/>
 </Grid>
</Window>
