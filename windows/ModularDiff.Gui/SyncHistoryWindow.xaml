<Window x:Class="ModularDiff.Gui.SyncHistoryWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:ModularDiff.Gui.Controls" Title="ModularDiff" ui:Loc.Key="sync_history_title" Width="1120" Height="680" MinWidth="850" MinHeight="440" WindowStartupLocation="CenterOwner" Background="#F1F3F7" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="12">
 <Grid x:Name="HistoryRoot" Margin="8" Background="#F1F3F7"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="180"/><RowDefinition Height="6"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,6"><StackPanel DockPanel.Dock="Left" Orientation="Horizontal"><Button x:Name="RestoreButton" Click="RestoreClick" Style="{StaticResource IconButton}" Content="&#xE7A7;" FontFamily="Segoe MDL2 Assets" ui:Loc.TipKey="sync_hist_restore_tip" IsEnabled="False"/><Button x:Name="RefreshButton" Click="RefreshClick" Style="{StaticResource IconButton}" Content="&#xE72C;" FontFamily="Segoe MDL2 Assets" ui:Loc.TipKey="sync_hist_refresh_tip"/><Button x:Name="StopButton" Click="StopClick" Style="{StaticResource IconButton}" Content="&#xE71A;" FontFamily="Segoe MDL2 Assets" ui:Loc.TipKey="sync_hist_stop_tip" IsEnabled="False"/><Button x:Name="CloseHistoryButton" Click="CloseClick" Style="{StaticResource IconButton}" Content="&#xE711;" FontFamily="Segoe MDL2 Assets" ui:Loc.TipKey="sync_hist_close_tip"/></StackPanel><TextBlock x:Name="Summary" Margin="10,0" VerticalAlignment="Center"/></DockPanel>
  <TextBlock x:Name="StoreLabel" Grid.Row="1" Foreground="#64748B" TextTrimming="CharacterEllipsis" Margin="2,0,2,6"/>
  <DataGrid x:Name="OperationsGrid" Grid.Row="2" SelectionChanged="OperationSelected"><DataGrid.Columns><DataGridTextColumn ui:Loc.Key="sync_col_time" Binding="{Binding Time}" Width="155"/><DataGridTextColumn ui:Loc.Key="col_status" Binding="{Binding State}" Width="110"/><DataGridTextColumn ui:Loc.Key="sync_col_files" Binding="{Binding Count}" Width="50"/><DataGridTextColumn ui:Loc.Key="sync_col_left_root" Binding="{Binding Operation.LeftRoot}" Width="*"/><DataGridTextColumn ui:Loc.Key="sync_col_right_root" Binding="{Binding Operation.RightRoot}" Width="*"/></DataGrid.Columns></DataGrid>
  <GridSplitter Grid.Row="3" Height="4" HorizontalAlignment="Stretch" Background="#DCE2EB"/>
  <DataGrid x:Name="EntriesGrid" Grid.Row="4" IsReadOnly="False" RowHeight="28"><DataGrid.Columns><DataGridTemplateColumn ui:Loc.Key="sync_col_restore" Width="45"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding Selected, Mode=TwoWay}" IsEnabled="{Binding CanRestore}" Margin="10,0" ui:Loc.TipKey="sync_restore_check_tip"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn ui:Loc.Key="sync_col_relpath" Binding="{Binding Item.RelativePath}" Width="*" IsReadOnly="True"/><DataGridTextColumn ui:Loc.Key="sync_col_restore_action" Binding="{Binding Item.Action, Converter={StaticResource LocText}}" Width="240" IsReadOnly="True"/><DataGridTextColumn ui:Loc.Key="sync_col_conflict_reason" Binding="{Binding Item.Reason, Converter={StaticResource LocText}}" Width="2*" IsReadOnly="True"/></DataGrid.Columns><DataGrid.RowStyle><Style TargetType="DataGridRow"><Setter Property="ToolTip" Value="{Binding Item.Target}"/></Style></DataGrid.RowStyle></DataGrid>
  <TextBlock x:Name="Status" Grid.Row="5" TextTrimming="CharacterEllipsis" Margin="2,6,2,0" Foreground="#64748B"/>
 </Grid>
</Window>
